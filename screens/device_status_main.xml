<!--
 设备状态总览 — 单屏工业设备监控面板（1080x600）

 布局：
   第 1 行  标题栏（标题 + 时间 + 设备/趋势 分段控件）
   第 2 行  设备运行状态（状态列表） | 温湿度传感器数据（两个环形仪表）
   第 3 行  数字量输入 DI(4) | 数字量输出 DO(4)（整行铺满）

 DI 每路 4 个数据点，只读展示 ON/OFF；DO 每路 4 个数据点，用 lv_button 控件
 开关，点击切换 ON/OFF（开光逻辑在 device_status.c 的 device_status_io_init 里）。

 所有坐标都是 1080x600 画布上的绝对像素，与
 screens/device_status_main_gen.c 一一对应。
-->
<screen>
	<styles>
		<!-- 白底圆角卡片 -->
		<style
			name="card"
			bg_color="0xffffff"
			bg_opa="100%"
			radius="12"
			border_width="0"
			pad_all="0"
			shadow_color="0x8c99a6"
			shadow_width="18"
			shadow_opa="15%"
			shadow_offset_y="4"
			shadow_spread="-2"
		/>
		<!-- 无背景的纯布局容器 -->
		<style
			name="plain"
			bg_opa="0%"
			border_width="0"
			radius="0"
			pad_all="0"
		/>
		<!-- 状态圆点 -->
		<style name="dot" radius="999" border_width="0" pad_all="0" />
		<!-- DI 数据点底板（只读） -->
		<style
			name="tile"
			bg_color="0xf7f8fa"
			bg_opa="100%"
			radius="10"
			border_width="0"
			pad_all="0"
			shadow_width="0"
		/>
		<!-- DO 数据点底板（按钮，白底描边） -->
		<style
			name="tile_btn"
			bg_color="0xffffff"
			bg_opa="100%"
			radius="10"
			border_width="1"
			border_color="0xe6e9ec"
			pad_all="0"
			shadow_width="0"
		/>
		<!-- ON / OFF 状态标记 -->
		<style
			name="mark_on"
			bg_color="0x16a6a1"
			bg_opa="100%"
			radius="8"
			border_width="0"
			pad_all="0"
			shadow_width="0"
		/>
		<style
			name="mark_off"
			bg_color="0xf0f2f5"
			bg_opa="100%"
			radius="8"
			border_width="0"
			pad_all="0"
			shadow_width="0"
		/>
		<!-- 分段控件：轨道 + 选中态 -->
		<style
			name="seg_track"
			bg_color="0xedeef1"
			bg_opa="100%"
			radius="999"
			border_width="0"
			pad_all="0"
		/>
		<style
			name="seg_active"
			bg_color="0xffffff"
			bg_opa="100%"
			radius="999"
			border_width="0"
			shadow_color="0x6b7683"
			shadow_width="6"
			shadow_opa="16%"
			shadow_offset_y="1"
		/>
		<!-- 1px 分隔线 -->
		<style
			name="divider"
			bg_color="0xeaedf0"
			bg_opa="100%"
			border_width="0"
			radius="0"
			pad_all="0"
		/>
		<!-- 环形仪表：底环 / 指示弧 / 底部细条 -->
		<style
			name="arc_track"
			arc_color="0xe9ecef"
			arc_width="6"
			arc_rounded="true"
			bg_opa="0%"
		/>
		<style
			name="arc_ind"
			arc_color="0x16a6a1"
			arc_width="6"
			arc_rounded="true"
			pad_all="0"
		/>
		<!-- 旋钮默认是一个蓝色圆点，静态仪表里要隐藏 -->
		<style
			name="arc_knob"
			bg_opa="0%"
			border_width="0"
			pad_all="0"
			shadow_width="0"
		/>
		<style
			name="bar_track"
			bg_color="0xe9ecef"
			bg_opa="100%"
			radius="999"
		/>
		<style name="bar_ind" bg_color="0x16a6a1" bg_opa="100%" radius="999" />
	</styles>

